# Supabase PostgreSQL Connection String (Transaction Mode Pooler port 6543 for serverless/Vercel)
# NOTE: never put your real password in this file or any committed file —
# set real values only in backend/.env (gitignored) or Vercel Environment Variables.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Supabase Auth Configuration (Dashboard -> Project Settings -> API / API Keys)
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...[ANON-PUBLIC-KEY]
# Secret API key (starts with sb_secret_... or service_role key) for IP Forwarding & backend auth
SUPABASE_SECRET_KEY=sb_secret_...[SECRET-KEY]

# Legacy Admin Authentication — Kept as fallback during migration
ADMIN_USERNAME=pick-a-name-that-is-not-admin
ADMIN_PASSWORD_HASH=[GENERATED-BCRYPT-HASH]
JWT_SECRET=[GENERATED-RANDOM-HEX]
