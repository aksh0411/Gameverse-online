# Supabase PostgreSQL Connection String (Transaction Mode Pooler port 6543 for serverless/Vercel)
# NOTE: never put your real password in this file or any committed file —
# set real values only in backend/.env (gitignored) or Vercel Environment Variables.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Authentication — the app refuses to start without all three.
ADMIN_USERNAME=pick-a-name-that-is-not-admin

# Generate with:  python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR-STRONG-PASSWORD', bcrypt.gensalt()).decode())"
ADMIN_PASSWORD_HASH=[GENERATED-BCRYPT-HASH]

# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=[GENERATED-RANDOM-HEX]
