  "cards": [
    {
      "dot": "cyan",
      "title": "Request path",
      "items": [
        "vercel.json rewrites /api/* to api/index.py, whose middleware restores the original path from ?realpath before routing",
        "Locally, uvicorn serves public/ at / and /static, adding no-cache headers to html/js/css responses",
        "Health check at /health and /api/health; /docs, /redoc and /openapi.json are disabled when VERCEL is set"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data layer",
      "items": [
        "psycopg pool (1-3 connections) opens at startup and re-syncs primary-key sequences for 8 tables",
        "Game list supports search, genre, platform, status, bookmark and favorite filters with paging",
        "Cover uploads write to public/static/images; on read-only serverless filesystems they fall back to base64 stored in the DB"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "All secrets come from environment variables only; startup fails closed without DATABASE_URL, JWT_SECRET or admin credentials",
        "Admin login verifies a bcrypt hash and issues a 4-hour HS256 JWT; 10 failed attempts per 15 minutes per IP return 429",
        "TLS to PostgreSQL is enforced (sslmode=require); CORS allows all origins with credentials"
      ]
    }
  ]
